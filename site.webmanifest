{
  "id": "./",
  "name": "MediaGrabber Pro",
  "short_name": "MG Pro",
  "description": "Free, private PDF and image tools that run in your browser: Image to PDF, JPG to PDF, Smart OCR, PDF password remover, PDF reader, image converter, Base64 and more.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#05070f",
  "theme_color": "#7c3aed",
  "lang": "en",
  "categories": [
    "utilities",
    "productivity",
    "photo"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Image to PDF",
      "short_name": "Image→PDF",
      "description": "Convert JPG, PNG and photos to a PDF",
      "url": "./?tool=image-to-pdf#image-to-pdf",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Smart OCR",
      "short_name": "OCR",
      "description": "Extract text from images and PDFs",
      "url": "./?tool=ocr#ocr",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Remove PDF Password",
      "short_name": "Unlock PDF",
      "description": "Unlock a password-protected PDF",
      "url": "./?tool=pdf-password-remover#pdf-password-remover",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Image Converter",
      "short_name": "Converter",
      "description": "Convert images between JPG, PNG and WebP",
      "url": "./?tool=image-converter#image-converter",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "description": "Combine PDFs into one",
      "url": "./?tool=pdfmerge#pdfmerge",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "PDF Reader",
      "short_name": "Reader",
      "description": "Read and annotate PDFs",
      "url": "./?tool=pdf-reader#pdf-reader",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Base64 Converter",
      "short_name": "Base64",
      "description": "Encode and decode Base64",
      "url": "./?tool=base64#base64",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "HEIC to JPG",
      "short_name": "HEIC",
      "description": "Convert iPhone photos",
      "url": "./?tool=heic2jpg#heic2jpg",
      "icons": [
        {
          "src": "android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".gif",
          ".bmp",
          ".heic",
          ".heif"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-phone.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MediaGrabber Pro tools"
    },
    {
      "src": "screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MediaGrabber Pro on desktop"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "handle_links": "preferred",
  "dir": "ltr",
  "prefer_related_applications": false
}